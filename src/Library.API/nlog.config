<?xml version="1.0" encoding="utf-8" ?>
<!--
  Loaded by NLog.LogManager.Setup().LoadConfigurationFromAppSettings() in Program.cs.
  appsettings has no "NLog" section, so this file is the configuration.
  ${configsetting} reads appsettings.json / appsettings.{Environment}.json.
-->
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      throwConfigExceptions="true">

  <!-- date (UTC)|LEVEL|logger|correlation id ('-' outside a request)|message, then |exception when there is one -->
  <variable name="lineLayout"
            value="${longdate:universalTime=true}|${level:uppercase=true}|${logger}|${scopeproperty:item=CorrelationId:whenEmpty=-}|${message}${onexception:inner=|${exception:format=tostring}}" />

  <targets>
    <!-- ${basedir} is the output folder (bin/Debug/net8.0); one file per UTC day. -->
    <target xsi:type="File" name="file"
            fileName="${basedir}/logs/library-${shortdate:universalTime=true}.log"
            encoding="utf-8"
            layout="${lineLayout}" />

    <target xsi:type="Console" name="console" layout="${lineLayout}" />
  </targets>

  <rules>
    <!-- Logging:LogLevel filters per category first; this is the floor for everything that reaches NLog. -->
    <logger name="*" minlevel="${configsetting:item=LogSettings.MinLevel:default=Info}" writeTo="file,console" />
  </rules>
</nlog>
