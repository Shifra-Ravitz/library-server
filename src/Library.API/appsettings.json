{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "LogSettings": {
    "MinLevel": "Info"
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "LibraryApi",
    "Audience": "LibraryClient",
    "ExpiryMinutes": 60
  },
  "LoanSettings": {
    "LoanPeriodDays": 14
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  }
}
